{
  "name": "llamalo-io",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:new-dev": "ng serve --configuration=new-dev",
    "build": "ng build --configuration production",
    "build:vercel": "node scripts/vercel-build.cjs",
    "build:preprod": "ng build --configuration preprod",
    "build:dev-deploy": "ng build --configuration dev-deploy",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:llamaloIO": "node dist/llamalo-io/server/server.mjs",
    "rename:voces": "node scripts/rename-voces.js",
    "deploy": "node scripts/deploy.js",
    "deploy:build": "npm run build && npm run deploy"
  },
  "private": true,
  "engines": {
    "node": ">=20.11 <23"
  },
  "dependencies": {
    "@angular/animations": "^19.2.19",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.19",
    "@angular/compiler": "^19.2.19",
    "@angular/core": "^19.2.19",
    "@angular/forms": "^19.2.19",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.19",
    "@angular/platform-browser-dynamic": "^19.2.19",
    "@angular/platform-server": "^19.2.19",
    "@angular/router": "^19.2.19",
    "@angular/ssr": "^19.2.22",
    "@ngrx/signals": "^19.1.0",
    "@sentry/angular": "^10.49.0",
    "@shopify/polaris": "^13.9.5",
    "apexcharts": "^5.3.6",
    "canvas-confetti": "^1.9.4",
    "driver.js": "^1.4.0",
    "express": "^4.18.2",
    "firebase": "^12.10.0",
    "lottie-web": "^5.13.0",
    "ng-apexcharts": "1.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.22",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^19.2.19",
    "@sentry/cli": "^3.4.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "autoprefixer": "^10.4.21",
    "basic-ftp": "^5.0.3",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.3",
